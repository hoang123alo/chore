<UserControl x:Class="UsbComposite.Views.ConnectDeviceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsbComposite.Views"
        xmlns:helpers="clr-namespace:UsbComposite.Helpers"
        mc:Ignorable="d"
         Background="#738A9C">
    
    
    <UserControl.Resources>
        <!-- Có thể bạn không cần khai báo lại nếu đã khai báo trong App.xaml -->
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>
    
    <Grid Margin="10">
        <!-- 2 cột -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="12*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- 3 hàng: trên và dưới nhỏ gọn -->
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="64"/>
            <!-- Hàng trên -->
            <RowDefinition Height="6*" MinHeight="64"/>
            <!-- Hàng giữa chứa GroupBox -->
            <RowDefinition Height="2*" MinHeight="78"/>
            <!-- Hàng dưới -->
        </Grid.RowDefinitions>

        <!-- Bạn có thể đặt gì đó vào hàng 0 -->
        <TextBlock Text="🔌 Chọn thiết bị để kết nối" 
               Grid.Row="0" Grid.ColumnSpan="5" 
               FontSize="30" FontWeight="Bold" 
               HorizontalAlignment="Center" 
               Margin="110,0,111,10" Width="380"/>
        <!-- 
        <GroupBox Grid.Row="0" Grid.Column="0"
                  Header="Gửi từng dòng"
                  Margin="10,0,10,10"
                  BorderBrush="#738A9C"
                  BorderThickness="0" FontSize="14" FontWeight="Bold">

            <Border BorderThickness="2" BorderBrush="#E0E0E0" Margin="2" CornerRadius="5">
        
        
        -->
        <!-- GroupBox CDC -->
        <GroupBox  Grid.Row="1" Grid.Column="1" 
                   Background="#2C3E50"
                   BorderThickness="0"
                   >
            <StackPanel Margin="5" Orientation="Vertical">
                <Label Content="ComPort" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="14" FontWeight="Bold"
                        Foreground ="White"/>
                <!-- Dòng 1: COM + Baudrate + Hiển thị kiểu dữ liệu -->
                <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                    <Label Content="COM " VerticalAlignment="Center" Foreground ="White" Margin="50,0,0,0"/>
                    <Label Content="Baud " VerticalAlignment="Center"  Foreground ="White" Margin="200,0,0,0" Width="41"/>
                </WrapPanel>
                
                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">

                    <ComboBox x:Name="cmbComPorts" Width="100" Margin="30,0,0,0"
          ItemsSource="{Binding CdcVM.AvailablePorts}"
          SelectedItem="{Binding CdcVM.SelectedPort}" />

                    
                    <ComboBox x:Name="cmbBaudRate" Width="100" Height="50" Margin="150,0,0,0"
                              VerticalAlignment="Center"
                       HorizontalAlignment="Center"
          SelectedItem="{Binding CdcVM.SelectedBaudRate}">
                        <ComboBoxItem Content="9600"/>
                        <ComboBoxItem Content="19200"/>
                        <ComboBoxItem Content="38400"/>
                        <ComboBoxItem Content="115200" IsSelected="True"/>
                        <ComboBoxItem Content="230400"/>
                        <ComboBoxItem Content="460800"/>
                        <ComboBoxItem Content="921600"/>
                    </ComboBox>

                </WrapPanel>

                <!-- Dòng 2: DataBits + Parity + StopBits -->
                <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">

                    <Label Content="Data Bits:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbDataBits" Width="50" Margin="5,0" 
                                          SelectedItem="{Binding CdcVM.SelectedDataBits}">
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8" IsSelected="True"/>
                    </ComboBox>

                    <Label Content="Parity:" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbParity" Width="70" Margin="5,0" 
                                          SelectedItem="{Binding CdcVM.SelectedParity}">
                        <ComboBoxItem Content="None" IsSelected="True"/>
                        <ComboBoxItem Content="Odd"/>
                        <ComboBoxItem Content="Even"/>
                    </ComboBox>

                    <Label Content="Stop Bits:" Margin="1,0,0,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbStopBits" Width="50" Margin="5,0" 
                                          SelectedItem="{Binding CdcVM.SelectedStopBits}">
                        <ComboBoxItem Content="One" IsSelected="True"/>
                        <ComboBoxItem Content="Two"/>
                    </ComboBox>

                </WrapPanel>

                <!-- Dòng 3: CR LF + Mở/Đóng COM -->
                    <Border BorderThickness="2" BorderBrush="#E0E0E0" Margin="2" CornerRadius="5">
                <WrapPanel Margin="0,10,0,0">

                        <Button Content="Open COM"
        Command="{Binding CdcVM.OpenComCommand}"
        IsEnabled="{Binding CdcVM.IsSerialOpen, Converter={StaticResource InverseBoolConverter}}"
        Width="70" Height="50" Margin="0,0,100,0" 
                                HorizontalAlignment="Left"/>
                        <Button Content="Close COM"
        Command="{Binding CdcVM.CloseComCommand}"
        IsEnabled="{Binding CdcVM.IsSerialOpen}"
        Width="80" 
                                HorizontalAlignment="Right"/>

                    </WrapPanel>
             </Border>

            </StackPanel>

        </GroupBox>

        <!-- GroupBox HID -->
        <GroupBox  Grid.Row="1" Grid.Column="3"  
                   Background="#2C3E50"
                   BorderThickness="0">
            <Grid Margin="10" Background="#2C3E50">
                <!-- Nền nhẹ để dễ nhìn Grid -->

                <!-- Định nghĩa 5 hàng -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Hàng 0: Chiều cao tự động, cho 1 cột -->
                    <RowDefinition Height="*"/>
                    <!-- Hàng 1: Chiều cao tự động, cho 2 cột -->
                    <RowDefinition Height="*"/>
                    <!-- Hàng 2: Chiều cao tự động, cho 3 cột -->
                    <RowDefinition Height="*"/>
                    <!-- Hàng 3: Chiều cao tự động, cho 2 cột -->
                    <RowDefinition Height="*"/>
                    <!-- Hàng 4: Chiều cao tự động, cho 2 cột -->
                </Grid.RowDefinitions>

                <!-- Định nghĩa 6 cột (để linh hoạt chia 2 hoặc 3 cột) -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Cột 0 -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột 1 -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột 2 -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột 3 -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột 4 -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột 5 -->
                </Grid.ColumnDefinitions>

                <!-- Hàng 0: Chỉ có 1 cột (kéo dài qua 6 cột) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" 
            Background="#4A90E2" CornerRadius="5" Margin="5">
                    <TextBlock Text="Hàng 0: Một cột duy nhất" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Padding="10" FontWeight="Bold"/>
                </Border>

                <!-- Hàng 1: 2 cột (mỗi cột kéo dài qua 3 cột con) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
        Background="#6B7A8F" CornerRadius="5" Margin="5">
                    <!-- BẮT ĐẦU: THAY THẾ TEXTBLOCK BẰNG MỘT GRID MỚI -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 1: Chiếm một phần không gian -->
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 2: Chiếm một phần không gian -->
                        </Grid.RowDefinitions>

                        <!-- Nội dung cho hàng nhỏ thứ nhất -->
                        <TextBlock Grid.Row="0" Text="Hàng 1, Cột 0 - Phần trên" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

                        <!-- Nội dung cho hàng nhỏ thứ hai -->
                        <Border Grid.Row="1" Background="#5A6B7F" CornerRadius="3" Margin="5">
                            <TextBlock Text="Hàng 1, Cột 0 - Phần dưới" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                        </Border>
                    </Grid>
                    <!-- KẾT THÚC: GRID MỚI -->
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" 
            Background="#6B7A8F" CornerRadius="5" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 1: Chiếm một phần không gian -->
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 2: Chiếm một phần không gian -->
                        </Grid.RowDefinitions>

                        <!-- Nội dung cho hàng nhỏ thứ nhất -->
                        <TextBlock Grid.Row="0" Text="Hàng 1, Cột 0 - Phần trên" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

                        <!-- Nội dung cho hàng nhỏ thứ hai -->
                        <Border Grid.Row="1" Background="#5A6B7F" CornerRadius="3" Margin="5">
                            <TextBlock Text="Hàng 1, Cột 0 - Phần dưới" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Hàng 2: 3 cột (mỗi cột kéo dài qua 2 cột con) -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
            Background="#FF6B6B" CornerRadius="5" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 1: Chiếm một phần không gian -->
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 2: Chiếm một phần không gian -->
                        </Grid.RowDefinitions>

                        <!-- Nội dung cho hàng nhỏ thứ nhất -->
                        <TextBlock Grid.Row="0" Text="Hàng 1, Cột 0 - Phần trên" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

                        <!-- Nội dung cho hàng nhỏ thứ hai -->
                        <Border Grid.Row="1" Background="#5A6B7F" CornerRadius="3" Margin="5">
                            <TextBlock Text="Hàng 1, Cột 0 - Phần dưới" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
            Background="#FF6B6B" CornerRadius="5" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 1: Chiếm một phần không gian -->
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 2: Chiếm một phần không gian -->
                        </Grid.RowDefinitions>

                        <!-- Nội dung cho hàng nhỏ thứ nhất -->
                        <TextBlock Grid.Row="0" Text="Hàng 1, Cột 0 - Phần trên" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

                        <!-- Nội dung cho hàng nhỏ thứ hai -->
                        <Border Grid.Row="1" Background="#5A6B7F" CornerRadius="3" Margin="5">
                            <TextBlock Text="Hàng 1, Cột 0 - Phần dưới" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2"
            Background="#FF6B6B" CornerRadius="5" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 1: Chiếm một phần không gian -->
                            <RowDefinition Height="*"/>
                            <!-- Hàng nhỏ 2: Chiếm một phần không gian -->
                        </Grid.RowDefinitions>

                        <!-- Nội dung cho hàng nhỏ thứ nhất -->
                        <TextBlock Grid.Row="0" Text="Hàng 1, Cột 0 - Phần trên" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

                        <!-- Nội dung cho hàng nhỏ thứ hai -->
                        <Border Grid.Row="1" Background="#5A6B7F" CornerRadius="3" Margin="5">
                            <TextBlock Text="Hàng 1, Cột 0 - Phần dưới" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Hàng 3: 2 cột (mỗi cột kéo dài qua 3 cột con) -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
            Background="#4CAF50" CornerRadius="5" Margin="5">
                    <TextBlock Text="Hàng 3, Cột 0" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3" 
            Background="#4CAF50" CornerRadius="5" Margin="5">
                    <TextBlock Text="Hàng 3, Cột 1 (kéo dài)" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10"/>
                </Border>

                <!-- Hàng 4: 2 cột (mỗi cột kéo dài qua 3 cột con) -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
            Background="#FFC107" CornerRadius="5" Margin="5">
                    <TextBlock Text="Hàng 4, Cột 0" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="3" 
            Background="#FFC107" CornerRadius="5" Margin="5">
                    <TextBlock Text="Hàng 4, Cột 1 (kéo dài)" Foreground="White" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10"/>
                </Border>

            </Grid>

        </GroupBox>

        <!-- Hàng dưới cùng -->
        <TextBlock Text="⚠️ Vui lòng kết nối thiết bị trước khi thao tác" 
               Grid.Row="2" Grid.ColumnSpan="5" 
               FontSize="30" Foreground="DarkRed" 
               HorizontalAlignment="Center"
               Margin="0,10,0,0" Width="601"/>
    </Grid>
</UserControl>
